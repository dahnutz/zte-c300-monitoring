# Private configuration: copy to .env, chmod 600, and fill the four blank credential/target values.
# Single-quoted values keep $, # and spaces literal in Docker Compose.
SNMP_HOST=
SNMP_PORT=161
SNMP_COMMUNITY=
API_KEY=

# Synthetic topology only: replace with actual populated physical slots.
# Mixed cards: OLT_BOARDS=3:16,5:8. Start with one test slot.
OLT_BOARDS=3:16
OLT_TIMEZONE=UTC
SNMP_MAX_CONCURRENT=1
SNMP_TIMEOUT_SECONDS=5
SNMP_RETRIES=1
SNMP_MAX_REPETITIONS=10

# On-demand collection; no whole-chassis preload. Cached lists may refresh
# in the background when requested near expiry.
CACHE_PREWARM=false
REDIS_ONU_INFO_TTL=60
REDIS_EMPTY_ONU_ID_TTL=60

# Native defaults; Compose overrides the Redis host and container HTTP listener.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_MIN_IDLE_CONNECTIONS=1
REDIS_POOL_SIZE=4
SERVER_HOST=127.0.0.1
SERVER_PORT=8081
APP_ENV=production

# Durable ONU samples. Compose starts TimescaleDB; native runs omit the host.
TIMESCALEDB_USER=c300
TIMESCALEDB_PASSWORD=
TIMESCALEDB_DB=c300_monitoring
# Enable only after one-PON acceptance and a polling-budget check.
# When true, the poller writes onu_samples plus status/UNI events and
# attempts unconfigured-ONU discovery (unsupported if the MIB walk fails).
POLL_ENABLED=false
POLL_INTERVAL_SECONDS=120
POLL_START_DELAY_SECONDS=15
DEVICE_VENDOR=zte
DEVICE_FAMILY=c300
DEVICE_ROLE=olt

# Build once, then run this tag. Use a NEW tag for each candidate/release.
COLLECTOR_IMAGE=zte-c300-monitoring:local-01
VERSION=local-01
COMMIT=uncommitted
BUILD_TIME=unknown
HTTP_PORT=8081
UI_PORT=8080
UI_IMAGE=zte-c300-monitoring-ui:local-01
# Keep app ports on loopback. Shared access needs an authenticated TLS edge.
BIND_ADDR=127.0.0.1
